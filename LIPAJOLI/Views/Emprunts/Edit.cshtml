@model LIPAJOLI.Models.Emprunt

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>Emprunt</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <div class="form-group">
                <label asp-for="DateEmprunt" class="control-label"></label>
                <input asp-for="DateEmprunt" class="form-control" />
                <span asp-validation-for="DateEmprunt" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="DateLimiteRetour" class="control-label"></label>
                <input asp-for="DateLimiteRetour" class="form-control" />
