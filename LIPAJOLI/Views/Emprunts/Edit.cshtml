            </div>
            <div class="form-group">
                <label asp-for="DateRetour" class="control-label"></label>
                <input asp-for="DateRetour" class="form-control" />
                <span asp-validation-for="DateRetour" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="LivreCode" class="control-label"></label>
                <select asp-for="LivreCode" class="form-control" asp-items="ViewBag.LivreCode"></select>
                <span asp-validation-for="LivreCode" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="UsagerNoAbonne" class="control-label"></label>
