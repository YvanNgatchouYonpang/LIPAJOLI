@model LIPAJOLI.Models.Livre

@{
    ViewData["Title"] = "Consultation du livre";
}

<h1>Consultation du livre</h1>

<hr />

<h3>Informations du livre</h3>

<dl class="row">

    <dt class="col-sm-3">
        Code
    </dt>

    <dd class="col-sm-9">
        @Model.Code
    </dd>

    <dt class="col-sm-3">
        ISBN-10
    </dt>

    <dd class="col-sm-9">
        @Model.ISBN10
    </dd>

    <dt class="col-sm-3">
        ISBN-13
    </dt>

    <dd class="col-sm-9">
        @Model.ISBN13
    </dd>

    <dt class="col-sm-3">
        Titre
    </dt>

    <dd class="col-sm-9">
        @Model.Titre
    </dd>

    <dt class="col-sm-3">
        Auteurs
    </dt>

    <dd class="col-sm-9">
        @Model.Auteurs
    </dd>

    <dt class="col-sm-3">
        Catégorie
    </dt>

    <dd class="col-sm-9">
        @Model.Categorie
    </dd>

    <dt class="col-sm-3">
        Quantité disponible
    </dt>

    <dd class="col-sm-9">
        @Model.Quantite
    </dd>

    <dt class="col-sm-3">
        Prix
    </dt>

    <dd class="col-sm-9">
        @Model.Prix.ToString("C")
    </dd>

</dl>

<hr />

<h3>Historique des emprunts</h3>

@if (Model.Emprunts == null || !Model.Emprunts.Any())
{
    <div class="alert alert-info">
        Aucun emprunt n'a encore été enregistré pour ce livre.
    </div>
}
else
{
    <table class="table table-bordered table-striped">

        <thead class="table-secondary">

            <tr>
                <th>Usager</th>
                <th>Date d'emprunt</th>
                <th>Date limite de retour</th>
                <th>Date de retour</th>
                <th>État</th>
            </tr>

        </thead>

        <tbody>

            @foreach (var emprunt in Model.Emprunts
                    .OrderByDescending(e => e.DateEmprunt))
            {
                bool enCours = emprunt.DateRetour == null;

                <tr class="@(enCours ? "table-warning" : "")">

                    <td>
                        @if (emprunt.Usager != null)
                        {
                            @emprunt.Usager.Nom
                            @emprunt.Usager.Prenom
                        }
                        else
                        {
                            @emprunt.UsagerNoAbonne
                        }
                    </td>

                    <td>
                        @emprunt.DateEmprunt.ToString("dd/MM/yyyy")
                    </td>

                    <td>
                        @emprunt.DateLimiteRetour.ToString("dd/MM/yyyy")
                    </td>

                    <td>
                        @if (emprunt.DateRetour.HasValue)
                        {
                @emprunt.DateRetour.Value.ToString("dd/MM/yyyy")
                                        }
                        else
                        {
                            <span class="text-danger">
                                Non retourné
                            </span>
                        }
                    </td>

                    <td>
                        @if (enCours)
                        {
                            <span class="badge bg-warning text-dark">
                                Emprunt en cours
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-success">
                                Retourné
                            </span>
                        }
                    </td>

                </tr>
            }

        </tbody>

    </table>
}

<hr />

<div>
    <a asp-action="Edit"
       asp-route-id="@Model.Code"
       class="btn btn-warning">
        Modifier
    </a>

    <a asp-action="Index"
       class="btn btn-secondary">
        Retour à la liste
    </a>
</div>