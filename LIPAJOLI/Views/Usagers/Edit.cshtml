@model LIPAJOLI.Models.Usager

@{
    ViewData["Title"] = "Modifier un usager";
}

<h1>Modifier un usager</h1>

<hr />

<form asp-action="Edit" method="post">

    <div asp-validation-summary="ModelOnly"
         class="text-danger">
    </div>

    <!-- Numéro d'abonné -->
    <div class="mb-3">

        <label asp-for="NoAbonne"
               class="form-label">
            N° d'abonné
        </label>

        <input asp-for="NoAbonne"
               class="form-control"
               readonly />

        <span asp-validation-for="NoAbonne"
              class="text-danger">
        </span>

    </div>

    <!-- Nom -->
    <div class="mb-3">

        <label asp-for="Nom"
               class="form-label">
            Nom
        </label>

        <input asp-for="Nom"
               class="form-control" />

        <span asp-validation-for="Nom"
              class="text-danger">
        </span>

    </div>

    <!-- Prénom -->
    <div class="mb-3">

        <label asp-for="Prenom"
               class="form-label">
            Prénom
        </label>

        <input asp-for="Prenom"
               class="form-control" />

        <span asp-validation-for="Prenom"
              class="text-danger">
        </span>

    </div>

    <!-- Statut -->
    <div class="mb-3">

        <label asp-for="Statut"
               class="form-label">
            Statut
        </label>

        <select asp-for="Statut"
                class="form-select">

            <option value="Etudiant">
                Étudiant
            </option>

            <option value="Enseignant">
                Enseignant
            </option>

        </select>

        <span asp-validation-for="Statut"
              class="text-danger">
        </span>

    </div>

    <!-- Courriel -->
    <div class="mb-3">

        <label asp-for="Email"
               class="form-label">
            Courriel
        </label>

        <input asp-for="Email"
               type="email"
               class="form-control" />

        <span asp-validation-for="Email"
              class="text-danger">
        </span>

    </div>

    <!-- Défaillance -->
    <div class="mb-3">

        <label class="form-label">
            Défaillances
        </label>

        <input value="@Model.Defaillance"
               class="form-control"
               readonly />

        <div class="form-text">
            Le nombre de défaillances est géré automatiquement
            par le système et ne peut pas être modifié.
        </div>

    </div>

    <button type="submit"
            class="btn btn-primary">
        Enregistrer les modifications
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Annuler
    </a>

</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}