@model IEnumerable<LIPAJOLI.Models.Usager>

@{
    ViewData["Title"] = "Gestion des usagers";
}

<h1>Gestion des usagers</h1>

@if (TempData["Succes"] != null)
{
    <div class="alert alert-success">
        @TempData["Succes"]
    </div>
}

@if (TempData["Erreur"] != null)
{
    <div class="alert alert-danger">
        @TempData["Erreur"]
    </div>
}

<div class="mb-3">

    <a asp-action="Create"
       class="btn btn-primary">
        Ajouter un usager
    </a>

</div>

<form asp-action="Index"
      method="get"
      class="mb-4">

    <div class="row">

        <div class="col-md-8">

            <input type="text"
                   name="recherche"
                   value="@Context.Request.Query["recherche"]"
                   class="form-control"
                   placeholder="Rechercher par nom ou prénom" />

        </div>

        <div class="col-md-2">

            <button type="submit"
                    class="btn btn-primary w-100">
                Rechercher
            </button>

        </div>

        <div class="col-md-2">

            <a asp-action="Index"
               class="btn btn-secondary w-100">
                Réinitialiser
            </a>

        </div>

    </div>

</form>

<table class="table table-bordered table-striped">

    <thead class="table-secondary">

        <tr>

            <th>
                N° d'abonné
            </th>

            <th>
                Nom
            </th>

            <th>
                Prénom
            </th>

            <th>
                Statut
            </th>

            <th>
                Défaillances
            </th>

            <th>
                Courriel
            </th>

            <th>
                Actions
            </th>

        </tr>

    </thead>

    <tbody>

        @foreach (var usager in Model)
        {
            <tr>

                <td>
                    @usager.NoAbonne
                </td>

                <td>
                    @usager.Nom
                </td>

                <td>
                    @usager.Prenom
                </td>

                <td>
                    @usager.Statut
                </td>

                <td>
                    @usager.Defaillance
                </td>

                <td>
                    @usager.Email
                </td>

                <td>

                    <a asp-action="Details"
                       asp-route-id="@usager.NoAbonne"
                       class="btn btn-info btn-sm">
                        Consulter
                    </a>

                    <a asp-action="Edit"
                       asp-route-id="@usager.NoAbonne"
                       class="btn btn-warning btn-sm">
                        Modifier
                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@usager.NoAbonne"
                       class="btn btn-danger btn-sm">
                        Supprimer
                    </a>

                </td>

            </tr>
        }

    </tbody>

</table>